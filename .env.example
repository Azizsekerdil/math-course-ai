# Math Course AI - example environment file.
#
# COPY this to .env (which is git-ignored) and fill in only what you need.
# NOTHING here is required to install or start the program.
# NEVER commit a real value. This file must only ever contain empty values or
# the literal placeholder YOUR_PROVIDER_API_KEY_HERE.

# ---------------------------------------------------------------- folders --
# Your own course PDFs. Not shipped, not redistributed, never uploaded.
MATH_COURSE_AI_RESOURCES=
# Where the program writes exports you asked for.
MATH_COURSE_AI_EXPORTS=
# Per-installation UI and session state.
MATH_COURSE_AI_SETTINGS=
# One-time migration source for pre-V43 databases. Leave empty unless migrating.
MATH_COURSE_AI_LEGACY_DATA=

# ------------------------------------------------- AI: local is the default --
# The local model needs no key at all. Leave the block below empty and the
# program runs entirely against LM Studio on this machine, with no network.

# OPTIONAL cloud provider (NVIDIA NIM). Leave EMPTY unless you want it.
# With no value the provider reports NOT_CONFIGURED and makes no call.
# Even with a key, nothing is sent until you pick the cloud provider AND accept
# the consent dialog in that session. See AI_TRANSPARENCY.md.
NVIDIA_API_KEY=YOUR_PROVIDER_API_KEY_HERE

# ---------------------------------------------------------------- danger --
# Running Python that a language model wrote. OFF by default in this release
# because no OS sandbox is enforced. Read docs/known-limitations.md before
# setting this to 1 - approved code runs with your full user rights.
MATH_COURSE_AI_ENABLE_CODE_EXECUTION=
