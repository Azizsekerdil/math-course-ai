# Satir sonu normalizasyonu.
#
# Depo su an tutarli (tum metin dosyalari LF olarak saklaniyor). Bu dosya onu
# ONCEDEN garanti altina alir: ortak gelistirmede herkesin core.autocrlf ayari
# ayni degildir ve tek bir yanlis ayarli makine "dosyanin tamami degismis"
# gibi gorunen sahte diff'ler uretip kod incelemesini imkansizlastirir.
# Kural: depoda her zaman LF, Windows calisma dizininde CRLF.

# Varsayilan: metin dosyalarini otomatik algila, depoda LF sakla.
* text=auto

# Kaynak ve dokuman
*.py     text
*.pyw    text
*.spec   text
*.md     text
*.txt    text
*.json   text
*.csv    text

# Windows'un CRLF bekledigi dosyalar (calisma dizininde her zaman CRLF)
*.ps1    text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Unix kabugu (git kancalari dahil) her zaman LF olmali
*.sh     text eol=lf

# Ikili dosyalar - hicbir donusum uygulanmasin
*.pdf    binary
*.ico    binary
*.png    binary
*.jpg    binary
*.rar    binary
*.zip    binary
*.sqlite binary
*.exe    binary
